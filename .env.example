# Copy to .env and fill in. Never commit .env.

# --- OpenAI ---
OPENAI_API_KEY=
# REALTIME_MODEL=gpt-realtime-2.1

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio number calls come from (E.164), e.g. +15551234567
TWILIO_PHONE_NUMBER=
# Verified number the development "call me" test dials (E.164), e.g. +61412345678
DEMO_CALL_TO_NUMBER=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Session pooler connection string
DATABASE_URL=

# --- Realtime server ---
# REALTIME_PORT=8787
# Public HTTPS URL Twilio can reach. Set automatically by `pnpm dev:phone` in development.
PUBLIC_BASE_URL=
# Random secret (24+ chars) guarding development-only endpoints. Generate: openssl rand -base64 32
DEV_ADMIN_TOKEN=
# Hard cap per outbound call, in seconds.
# CALL_MAX_DURATION_SECONDS=300

# --- Web app ---
# Base URL used in confirmation and reset emails (must be allowed in Supabase Auth → URL Configuration).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Demo data ---
# Shared password for the fictional demo accounts. Generated by `pnpm demo:reset` if missing.
DEMO_PASSWORD=
