# Copy to .env.test. Browser tests (pnpm test:e2e) and pnpm scheduler:check load this on top of .env.
# It must point at a SEPARATE Supabase project: tests reset demo data and create phone calls,
# and the live phone server dials every call in the live database. See CONTRIBUTING.md.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Session pooler connection string of the test project
DATABASE_URL=

# Always an ACMA fiction number, so the demo patient can never ring a real phone.
DEMO_CALL_TO_NUMBER=+61491570006
